---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import BandPage from '../../components/BandPage.astro';
import Footer from '../../components/Footer.astro';
import { bands, bandHref } from '../../data/bands';
import { useTranslations } from '../../i18n/utils';

export function getStaticPaths() {
  return bands.map((band) => ({ params: { slug: band.slug }, props: { band } }));
}

const { band } = Astro.props;
const t = useTranslations('en');

const bandPhoto = band.photos.find((p) => p.src)?.src;
const musicGroupSchema = {
  '@context': 'https://schema.org',
  '@type': 'MusicGroup',
  name: band.name,
  genre: t(band.metaKey),
  description: t(band.blurbKey),
  url: new URL(bandHref(band.slug, 'en'), Astro.site).href,
  ...(bandPhoto && { image: new URL(bandPhoto, Astro.site).href }),
  sameAs: band.links.filter((l) => l.href).map((l) => l.href),
  member: {
    '@type': 'Person',
    name: 'Adam Arling',
    url: new URL('/', Astro.site).href,
  },
};
---
<Layout
  title={`${band.name} — Adam Arling`}
  description={t(band.blurbKey)}
  lang="en"
  structuredData={[musicGroupSchema]}
>
  <Nav />
  <BandPage band={band} lang="en" />
  <Footer />
</Layout>
