---
import { useTranslations } from '../i18n/utils';
import { bandHref } from '../data/bands';

const lang = (Astro.currentLocale ?? 'en') as 'en' | 'de';
const t = useTranslations(lang);
---
<section class="projects" id="projects">
  <article class="featured" id="warrior-soul">
    <div class="content-col">
      <h3 class="featured-name">
        <a href={bandHref('warrior-soul', lang)}>WARRIOR SOUL</a>
      </h3>
      <div class="genre">{t('warriorSoul.genre')}</div>
      <p class="desc">{t('warriorSoul.description')}</p>
      <a href={bandHref('warrior-soul', lang)} class="cell-link">{t('band.view')} →</a>
    </div>

    <div class="photo-col">
      <div class="photo-main">
        <img src="/images/warrior-soul-singer-guitar.jpg" alt="Warrior Soul performing live" loading="lazy" />
      </div>
      <div class="photo-secondary">
        <img src="/images/warrior-soul-marshall.jpg" alt="Adam Arling on guitar with Warrior Soul in front of a Marshall stack" loading="lazy" />
      </div>
    </div>
  </article>
</section>

<style>
  .projects {
    border-bottom: 4px solid var(--text);
  }

  .featured {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 56px;
    padding: 72px 64px 72px 80px;
    overflow: hidden;
  }

  .content-col {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .featured-name {
    font-family: var(--font-display);
    font-size: clamp(48px, 6vw, 80px);
    line-height: 0.92;
    letter-spacing: 0.02em;
    margin: 0 0 18px 0;
  }

  .featured-name a {
    transition: color 0.15s;
  }

  .featured-name a:hover {
    color: var(--accent);
  }

  .genre {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--accent);
    text-transform: uppercase;
    font-weight: 700;
    letter-spacing: 0.1em;
    margin-bottom: 20px;
  }

  .desc {
    color: var(--muted);
    line-height: 1.75;
    font-size: 15px;
    max-width: 520px;
  }

  .cell-link {
    display: inline-block;
    margin-top: 24px;
    font-family: var(--font-mono);
    font-size: 12px;
    padding-bottom: 2px;
    border-bottom: 2px solid var(--accent);
    color: var(--text);
  }

  .cell-link:hover {
    border-color: var(--text);
  }

  .photo-col {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .photo-main img {
    width: 100%;
    height: 360px;
    object-fit: cover;
    display: block;
    border: 3px solid var(--accent);
  }

  .photo-secondary img {
    width: 100%;
    height: 200px;
    object-fit: cover;
    display: block;
  }

  @media (max-width: 900px) {
    .featured {
      grid-template-columns: 1fr;
      padding: 48px 32px 48px 40px;
      gap: 32px;
    }
  }
</style>
