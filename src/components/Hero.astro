---
import { useTranslations } from '../i18n/utils';

const lang = (Astro.currentLocale ?? 'en') as 'en' | 'de';
const t = useTranslations(lang);
---
<section class="hero" id="hero">
  <div class="left-stripe"></div>

  <div class="hero-inner">
    <div class="hero-text">
      <div class="tagline">{t('hero.tagline')}</div>

      <div class="name-wrap">
        <h1 class="name-outline">ADAM</h1>
        <h1 class="name-solid">ARLING</h1>

        <div class="badge-wrap" aria-hidden="true">
          <svg viewBox="0 0 200 200" class="badge">
            <defs>
              <path
                id="badge-circle"
                d="M 100,100 m -78,0 a 78,78 0 1,1 156,0 a 78,78 0 1,1 -156,0"
              />
            </defs>
            <circle cx="100" cy="100" r="90" fill="none" stroke="var(--accent)" stroke-width="1.5" />
            <text>
              <textPath href="#badge-circle" style="font-size:12px;font-family:'Space Mono',monospace;letter-spacing:3px;fill:var(--text);">
                MUSICIAN ✦ VIENNA ✦ CHICAGO ✦ GUITAR ✦{' '}
              </textPath>
            </text>
          </svg>
        </div>
      </div>

      <div class="location">{t('hero.location')}</div>

      <div class="socials">
        <a
          href="https://www.instagram.com/adamarling"
          target="_blank"
          rel="noopener noreferrer"
          class="pill">Instagram</a
        >
        <a
          href="https://open.spotify.com/artist/3YH7l3x1bpAzYRIk9RFV9K"
          target="_blank"
          rel="noopener noreferrer"
          class="pill">Spotify</a
        >
        <a
          href="https://thedragsband.bandcamp.com"
          target="_blank"
          rel="noopener noreferrer"
          class="pill">Bandcamp</a
        >
        <a
          href="https://www.facebook.com/adamarling"
          target="_blank"
          rel="noopener noreferrer"
          class="pill">Facebook</a
        >
      </div>
    </div>

    <div class="hero-photo">
      <img src="/images/warrior-soul-live.jpg" alt="Adam Arling performing live" />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    border-bottom: 6px solid var(--neon);
    overflow: hidden;
  }

  .left-stripe {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 8px;
    background: var(--accent);
    z-index: 2;
  }

  .hero-inner {
    display: grid;
    grid-template-columns: 1fr 42%;
    min-height: calc(100vh - 68px);
  }

  .hero-text {
    padding: 72px 48px 72px 80px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .tagline {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--accent);
    font-weight: 700;
    margin-bottom: 40px;
  }

  .name-wrap {
    position: relative;
  }

  .name-outline {
    font-family: var(--font-display);
    font-size: clamp(80px, 11vw, 160px);
    line-height: 0.82;
    letter-spacing: 0.14em;
    -webkit-text-stroke: 3px var(--text);
    -webkit-text-fill-color: transparent;
    color: transparent;
  }

  .name-solid {
    font-family: var(--font-display);
    font-size: clamp(80px, 11vw, 160px);
    line-height: 0.88;
    letter-spacing: -0.01em;
    margin-top: -4px;
  }

  .badge-wrap {
    position: absolute;
    bottom: -28px;
    right: 0;
  }

  .badge {
    width: 130px;
    height: 130px;
    animation: spin-slow 25s linear infinite;
  }

  .location {
    margin-top: 48px;
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--muted);
    letter-spacing: 0.05em;
  }

  .socials {
    margin-top: 20px;
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .pill {
    background: var(--accent);
    color: #fff;
    padding: 9px 18px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: 700;
    display: inline-block;
    transition: background 0.15s;
  }

  .pill:hover {
    background: var(--text);
  }

  .hero-photo {
    position: relative;
    overflow: hidden;
  }

  .hero-photo img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
  }

  @media (max-width: 900px) {
    .hero-inner {
      grid-template-columns: 1fr;
    }

    .hero-photo {
      height: 60vw;
      position: relative;
    }

    .hero-photo img {
      position: absolute;
    }

    .hero-text {
      padding: 48px 32px 48px 40px;
    }
  }
</style>
