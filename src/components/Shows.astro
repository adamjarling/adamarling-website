---
import { useTranslations } from '../i18n/utils';
import { bandHref } from '../data/bands';

const lang = (Astro.currentLocale ?? 'en') as 'en' | 'de';
const t = useTranslations(lang);

const shows = [
  { date: '14 JUN', band: 'The Drags', slug: 'the-drags', venue: 'Chelsea, Vienna' },
  { date: '28 JUN', band: 'DeLoreans', slug: 'deloreans', venue: 'Café Carina, Vienna' },
  { date: '12 JUL', band: 'The Drags', slug: 'the-drags', venue: 'Arena Wien, Vienna' },
  { date: '02 AUG', band: 'The Drags', slug: 'the-drags', venue: 'B72, Vienna' },
];
---
<section class="shows" id="shows">
  <div class="neon-stripe"></div>
  <div class="inner">
    <h2 class="title">{t('shows.title')}</h2>
    <div class="list">
      {
        shows.map((show, i) => (
          <div class:list={['row', i === 0 && 'row-first']}>
            <a class="row-main" href={bandHref(show.slug, lang)}>
              <span class="date">{show.date}</span>
              <div class="band-venue">
                <span class="band">
                  {show.band}
                  <span class="arrow" aria-hidden="true">→</span>
                </span>
                <span class="venue">{show.venue}</span>
              </div>
            </a>
            <button class="ticket">{t('shows.tickets')}</button>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .shows {
    position: relative;
    padding: 64px 64px 64px 80px;
    border-bottom: 4px solid var(--text);
  }

  .neon-stripe {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 8px;
    background: var(--neon);
  }

  .inner {
    position: relative;
  }

  .title {
    font-family: var(--font-display);
    font-size: clamp(40px, 5vw, 56px);
    letter-spacing: 0.03em;
    margin-bottom: 32px;
  }

  .list {
    display: flex;
    flex-direction: column;
  }

  .row {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 20px;
    border-top: 1px solid rgba(17, 17, 17, 0.2);
  }

  .row-first {
    border-top: 3px solid var(--text);
  }

  .row-main {
    display: grid;
    grid-template-columns: 180px 1fr;
    align-items: center;
    gap: 20px;
    padding: 18px 0;
    color: var(--text);
    transition: padding-left 0.2s ease;
  }

  .row-main:hover {
    padding-left: 12px;
  }

  .date {
    font-family: var(--font-display);
    font-size: clamp(32px, 3.5vw, 44px);
    line-height: 1;
    color: var(--accent);
  }

  .band-venue {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .band {
    font-family: var(--font-mono);
    font-size: 14px;
    font-weight: 700;
  }

  .arrow {
    display: inline-block;
    margin-left: 8px;
    color: var(--accent);
    opacity: 0;
    transform: translateX(-6px);
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .row-main:hover .arrow,
  .row-main:focus-visible .arrow {
    opacity: 1;
    transform: translateX(0);
  }

  .venue {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--muted);
  }

  .ticket {
    background: var(--neon);
    color: var(--text);
    border: none;
    padding: 8px 20px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-weight: 700;
    cursor: pointer;
    transition: background 0.15s, color 0.15s;
    flex-shrink: 0;
  }

  .ticket:hover {
    background: var(--text);
    color: var(--neon);
  }

  @media (max-width: 768px) {
    .shows {
      padding: 48px 32px 48px 40px;
    }

    .row-main {
      grid-template-columns: 120px 1fr;
      gap: 12px;
    }
  }
</style>
