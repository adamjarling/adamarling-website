---
import { useTranslations } from '../i18n/utils';
import { bands, bandHref, type Band } from '../data/bands';

interface Props {
  band: Band;
  lang: 'en' | 'de';
}

const { band, lang } = Astro.props;
const t = useTranslations(lang);

const homeHref = lang === 'de' ? '/de/' : '/';
const note = (lang === 'de' && band.note.de) || band.note.en;
const others = bands.filter((b) => b.slug !== band.slug);
const galleryPhotos = band.photos
  .filter((p) => p.src)
  .map((p) => ({ src: p.src, alt: p.alt, caption: p.caption ?? null }));
---
<article class="band">
  <header class="band-header">
    <a href={homeHref} class="back">← {t('band.back')}</a>
    <h1 class="band-name">{band.name}</h1>
    <div class="meta">{t(band.metaKey)}</div>
  </header>

  <div class="body">
    <div class="prose">
      <section class="block">
        <h2 class="block-title">{t('band.about')}</h2>
        <p class="blurb">{t(band.blurbKey)}</p>
      </section>

      <section class="block">
        <h2 class="block-title">{t('band.note')}</h2>
        {
          note ? (
            <p class="note">{note}</p>
          ) : (
            <div class="note-placeholder">[ {t('band.notePlaceholder')} ]</div>
          )
        }
      </section>
    </div>

    <aside class="links-col">
      <h2 class="block-title">{t('band.links')}</h2>
      <ul class="links">
        {
          band.links.map((link) => (
            <li>
              {link.href ? (
                <a href={link.href} target="_blank" rel="noopener noreferrer" class="link">
                  <span class="link-label">{link.label}</span>
                  <span class="link-arrow" aria-hidden="true">↗</span>
                </a>
              ) : (
                <span class="link link-todo">
                  <span class="link-label">{link.label}</span>
                  <span class="link-todo-tag">{t('band.linkTodo')}</span>
                </span>
              )}
            </li>
          ))
        }
      </ul>
    </aside>
  </div>

  <section class="photos-section">
    <div class="photos-header">
      <h2 class="section-title">{t('band.photos')}</h2>
      <div class="accent-line"></div>
    </div>

    <div class="photo-grid">
      {
        band.photos.map((photo) => (
          <figure class:list={['photo', photo.span === 'wide' && 'span-2']}>
            {photo.src ? (
              <button
                type="button"
                class="photo-trigger"
                data-index={galleryPhotos.findIndex((p) => p.src === photo.src)}
              >
                <img src={photo.src} alt={photo.alt} loading="lazy" />
              </button>
            ) : (
              <div class="photo-placeholder">[ {photo.alt} ]</div>
            )}
            {photo.caption && <figcaption>{photo.caption}</figcaption>}
          </figure>
        ))
      }
    </div>

    <div class="lightbox" id="lightbox">
      <button type="button" class="lightbox-close" aria-label="Close">✕</button>
      <button type="button" class="lightbox-prev" aria-label="Previous photo">‹</button>
      <button type="button" class="lightbox-next" aria-label="Next photo">›</button>
      <figure class="lightbox-figure">
        <img class="lightbox-img" src="" alt="" />
        <figcaption class="lightbox-caption"></figcaption>
      </figure>
    </div>
  </section>

  <script define:vars={{ galleryPhotos }}>
    const lightbox = document.getElementById('lightbox');
    const imgEl = lightbox.querySelector('.lightbox-img');
    const captionEl = lightbox.querySelector('.lightbox-caption');
    const closeBtn = lightbox.querySelector('.lightbox-close');
    const prevBtn = lightbox.querySelector('.lightbox-prev');
    const nextBtn = lightbox.querySelector('.lightbox-next');
    const triggers = document.querySelectorAll('.photo-trigger');

    let currentIndex = 0;

    function show(index) {
      const total = galleryPhotos.length;
      currentIndex = (index + total) % total;
      const photo = galleryPhotos[currentIndex];
      imgEl.src = photo.src;
      imgEl.alt = photo.alt;
      captionEl.textContent = photo.caption || '';
      captionEl.hidden = !photo.caption;
    }

    function open(index) {
      show(index);
      lightbox.classList.add('open');
      document.body.style.overflow = 'hidden';
    }

    function close() {
      lightbox.classList.remove('open');
      document.body.style.overflow = '';
    }

    triggers.forEach((btn) => {
      btn.addEventListener('click', () => open(parseInt(btn.dataset.index, 10)));
    });

    closeBtn.addEventListener('click', close);
    prevBtn.addEventListener('click', () => show(currentIndex - 1));
    nextBtn.addEventListener('click', () => show(currentIndex + 1));

    lightbox.addEventListener('click', (e) => {
      if (e.target === lightbox) close();
    });

    document.addEventListener('keydown', (e) => {
      if (!lightbox.classList.contains('open')) return;
      if (e.key === 'Escape') close();
      if (e.key === 'ArrowLeft') show(currentIndex - 1);
      if (e.key === 'ArrowRight') show(currentIndex + 1);
    });
  </script>

  <nav class="more">
    <h2 class="block-title">{t('band.more')}</h2>
    <div class="more-list">
      {
        others.map((b) => (
          <a href={bandHref(b.slug, lang)} class="more-link">
            {b.name}
            <span class="more-arrow" aria-hidden="true">→</span>
          </a>
        ))
      }
    </div>
  </nav>
</article>

<style>
  /* Header */
  .band-header {
    position: relative;
    padding: 56px 64px 48px 80px;
    border-bottom: 4px solid var(--text);
  }

  .back {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--accent);
    margin-bottom: 28px;
    transition: color 0.15s;
  }

  .back:hover {
    color: var(--text);
  }

  .band-name {
    font-family: var(--font-display);
    font-size: clamp(56px, 9vw, 132px);
    line-height: 0.88;
    letter-spacing: 0.02em;
    margin: 0 0 18px 0;
  }

  .meta {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--accent);
    text-transform: uppercase;
    font-weight: 700;
    letter-spacing: 0.1em;
  }

  /* Body: prose + links */
  .body {
    display: grid;
    grid-template-columns: 1fr 320px;
    border-bottom: 4px solid var(--text);
  }

  .prose {
    padding: 56px 56px 56px 80px;
    border-right: 2px solid var(--text);
  }

  .block + .block {
    margin-top: 40px;
  }

  .block-title {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--neon);
    margin-bottom: 16px;
  }

  .blurb {
    color: var(--muted);
    line-height: 1.75;
    font-size: 15px;
    max-width: 620px;
  }

  .note {
    font-family: var(--font-serif);
    font-size: 21px;
    line-height: 1.6;
    max-width: 620px;
  }

  .note-placeholder {
    padding: 28px 24px;
    border: 1px dashed #999;
    background: linear-gradient(145deg, #D4CFC5 0%, #C5BFB3 100%);
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #888;
    text-align: center;
  }

  /* Links */
  .links-col {
    padding: 56px 64px 56px 40px;
  }

  .links {
    list-style: none;
    margin-top: 4px;
  }

  .link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 13px 0;
    border-bottom: 1px solid rgba(17, 17, 17, 0.2);
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.06em;
  }

  a.link:hover {
    color: var(--accent);
  }

  .link-arrow {
    color: var(--accent);
    transition: transform 0.2s ease;
  }

  a.link:hover .link-arrow {
    transform: translate(3px, -3px);
  }

  .link-todo {
    color: #999;
  }

  .link-todo-tag {
    font-size: 9px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    border: 1px dashed #999;
    padding: 3px 7px;
    flex-shrink: 0;
  }

  /* Photos */
  .photos-section {
    border-bottom: 4px solid var(--text);
  }

  .photos-header {
    padding: 48px 64px 32px 80px;
    display: flex;
    align-items: center;
    gap: 32px;
    border-bottom: 2px solid var(--text);
  }

  .section-title {
    font-family: var(--font-display);
    font-size: clamp(32px, 4vw, 48px);
    letter-spacing: 0.03em;
    flex-shrink: 0;
  }

  .accent-line {
    flex: 1;
    height: 4px;
    background: var(--neon);
  }

  .photo-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-auto-rows: 300px;
    gap: 3px;
  }

  .photo {
    position: relative;
    overflow: hidden;
    background: #d4cfc5;
  }

  .photo.span-2 {
    grid-column: span 2;
  }

  .photo img,
  .photo-placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s ease;
  }

  .photo:hover img {
    transform: scale(1.05);
  }

  .photo-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 16px;
    background: linear-gradient(145deg, #D4CFC5 0%, #C5BFB3 100%);
    border: 1px dashed #999;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #888;
  }

  .photo figcaption {
    padding: 10px 14px;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--muted);
  }

  .photo-trigger {
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    border: none;
    background: none;
    cursor: pointer;
  }

  .lightbox {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 1000;
    align-items: center;
    justify-content: center;
    padding: 48px;
    background: rgba(17, 17, 17, 0.92);
  }

  .lightbox.open {
    display: flex;
  }

  .lightbox-figure {
    max-width: 100%;
    max-height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }

  .lightbox-img {
    max-width: 100%;
    max-height: 80vh;
    object-fit: contain;
    display: block;
    border: 3px solid var(--bg);
  }

  .lightbox-caption {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--bg);
    text-align: center;
  }

  .lightbox-close,
  .lightbox-prev,
  .lightbox-next {
    position: absolute;
    background: none;
    border: none;
    color: var(--bg);
    font-family: var(--font-display);
    cursor: pointer;
    line-height: 1;
    transition: color 0.15s ease;
  }

  .lightbox-close:hover,
  .lightbox-prev:hover,
  .lightbox-next:hover {
    color: var(--neon);
  }

  .lightbox-close {
    top: 24px;
    right: 32px;
    font-size: 28px;
  }

  .lightbox-prev,
  .lightbox-next {
    top: 50%;
    transform: translateY(-50%);
    font-size: 56px;
    padding: 12px;
  }

  .lightbox-prev {
    left: 16px;
  }

  .lightbox-next {
    right: 16px;
  }

  @media (max-width: 768px) {
    .lightbox {
      padding: 24px;
    }

    .lightbox-prev,
    .lightbox-next {
      font-size: 40px;
    }
  }

  /* More bands */
  .more {
    padding: 48px 64px 56px 80px;
    border-bottom: 4px solid var(--text);
  }

  .more-list {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .more-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 18px;
    border: 2px solid var(--text);
    font-family: var(--font-display);
    font-size: 22px;
    letter-spacing: 0.04em;
    line-height: 1;
    transition: background 0.15s, color 0.15s;
  }

  .more-link:hover {
    background: var(--text);
    color: var(--bg);
  }

  .more-arrow {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--accent);
  }

  @media (max-width: 900px) {
    .band-header {
      padding: 40px 32px 36px 40px;
    }

    .body {
      grid-template-columns: 1fr;
    }

    .prose {
      padding: 40px 32px 40px 40px;
      border-right: none;
      border-bottom: 2px solid var(--text);
    }

    .links-col {
      padding: 40px 32px 40px 40px;
    }

    .photos-header {
      padding: 36px 32px 28px 40px;
    }

    .photo-grid {
      grid-template-columns: repeat(2, 1fr);
      grid-auto-rows: 220px;
    }

    .photo.span-2 {
      grid-column: span 2;
    }

    .more {
      padding: 36px 32px 44px 40px;
    }
  }
</style>
