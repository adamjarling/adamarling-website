---
import { useTranslations } from '../i18n/utils';

const lang = (Astro.currentLocale ?? 'en') as 'en' | 'de';
const t = useTranslations(lang);
---
<section class="about" id="about">
  <div class="content">
    <div class="text-col">
      <p class="bio">{t('about.bio')}</p>

      <div class="btns" id="contact">
        <a
          href="mailto:aarling@gmail.com"
          class="btn btn-solid">{t('about.press')}</a
        >
        <a
          href="mailto:aarling@gmail.com"
          class="btn btn-outline">{t('about.contact')}</a
        >
      </div>
    </div>

    <div class="photo-col">
      <div class="portrait">
        <img src="/images/portrait-staircase.jpg" alt="Adam Arling" />
      </div>
    </div>
  </div>
</section>

<style>
  .about {
    border-bottom: 6px solid var(--accent);
  }

  .content {
    display: grid;
    grid-template-columns: 1fr 0.65fr;
    gap: 56px;
    padding: 64px 64px 64px 80px;
    align-items: start;
  }

  .bio {
    color: var(--muted);
    line-height: 1.75;
    font-size: 16px;
  }

  .btns {
    margin-top: 28px;
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
  }

  .btn {
    padding: 10px 24px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    display: inline-block;
    transition: background 0.15s, color 0.15s, border-color 0.15s;
  }

  .btn-solid {
    background: var(--text);
    color: var(--bg);
    border: 2px solid var(--text);
  }

  .btn-solid:hover {
    background: var(--accent);
    border-color: var(--accent);
  }

  .btn-outline {
    border: 2px solid var(--text);
    color: var(--text);
    background: transparent;
  }

  .btn-outline:hover {
    background: var(--text);
    color: var(--bg);
  }

  .photo-col {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .portrait img {
    width: 100%;
    height: 560px;
    object-fit: cover;
    object-position: center top;
    display: block;
    border: 4px solid var(--accent);
  }

  @media (max-width: 900px) {
    .content {
      grid-template-columns: 1fr;
      padding: 48px 32px 48px 40px;
    }

    .photo-col {
      display: none;
    }
  }
</style>
