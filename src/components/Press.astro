---
import { useTranslations } from '../i18n/utils';
import { press } from '../data/press';

interface Props {
  lang: 'en' | 'de';
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const homeHref = lang === 'de' ? '/de/' : '/';
---
<article class="press">
  <header class="press-header">
    <a href={homeHref} class="back">← {t('band.back')}</a>
    <h1 class="page-name">{t('press.title')}</h1>
    <div class="meta">{t('press.blurb')}</div>
  </header>

  <section class="body">
    {
      press.length > 0 ? (
        <ul class="list">
          {press.map((item) => (
            <li class="row">
              <span class="date">{item.date}</span>
              <div class="detail">
                <div class="detail-meta">
                  <span class="outlet">{item.outlet}</span>
                  {item.band && <span class="band-tag">{item.band}</span>}
                  <span class="kind">{t(`press.kind.${item.kind ?? 'feature'}`)}</span>
                </div>
                {item.href ? (
                  <a href={item.href} target="_blank" rel="noopener noreferrer" class="item-title">
                    {item.title}
                    <span class="arrow" aria-hidden="true">↗</span>
                  </a>
                ) : (
                  <span class="item-title">{item.title}</span>
                )}
                {item.quote && <blockquote class="quote">“{item.quote}”</blockquote>}
              </div>
            </li>
          ))}
        </ul>
      ) : (
        <div class="placeholder">[ {t('press.placeholder')} ]</div>
      )
    }
  </section>
</article>

<style>
  .press {
    border-bottom: 4px solid var(--text);
  }

  .press-header {
    position: relative;
    padding: 56px 64px 48px 80px;
    border-bottom: 4px solid var(--text);
  }

  .back {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--accent);
    margin-bottom: 28px;
    transition: color 0.15s;
  }

  .back:hover {
    color: var(--text);
  }

  .page-name {
    font-family: var(--font-display);
    font-size: clamp(56px, 9vw, 132px);
    line-height: 0.88;
    letter-spacing: 0.02em;
    margin: 0 0 18px 0;
  }

  .meta {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--accent);
    text-transform: uppercase;
    font-weight: 700;
    letter-spacing: 0.1em;
  }

  .body {
    padding: 48px 64px 64px 80px;
  }

  .placeholder {
    padding: 56px 24px;
    background: linear-gradient(145deg, #d4cfc5 0%, #c5bfb3 100%);
    border: 1px dashed #999;
    text-align: center;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #888;
  }

  .list {
    display: flex;
    flex-direction: column;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .row {
    display: grid;
    grid-template-columns: 140px 1fr;
    align-items: baseline;
    gap: 24px;
    padding: 24px 0;
    border-top: 1px solid rgba(17, 17, 17, 0.2);
  }

  .row:first-child {
    border-top: 3px solid var(--text);
  }

  .date {
    font-family: var(--font-display);
    font-size: 32px;
    line-height: 1;
    color: var(--accent);
  }

  .detail {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .detail-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .outlet {
    color: var(--muted);
    font-weight: 700;
  }

  .band-tag,
  .kind {
    font-size: 10px;
    letter-spacing: 0.12em;
    padding: 3px 8px;
  }

  .band-tag {
    background: var(--text);
    color: var(--bg);
    font-weight: 700;
  }

  .kind {
    border: 1px solid var(--line, rgba(17, 17, 17, 0.3));
    color: var(--muted);
  }

  .item-title {
    font-family: var(--font-mono);
    font-size: 15px;
    font-weight: 700;
    color: var(--text);
    line-height: 1.5;
  }

  a.item-title {
    border-bottom: 2px solid var(--accent);
    padding-bottom: 2px;
    align-self: flex-start;
    transition: border-color 0.15s;
  }

  a.item-title:hover {
    border-color: var(--text);
  }

  .arrow {
    margin-left: 6px;
    color: var(--accent);
  }

  .quote {
    margin: 4px 0 0 0;
    padding-left: 16px;
    border-left: 3px solid var(--neon);
    font-family: var(--font-serif);
    font-size: 18px;
    font-style: italic;
    line-height: 1.5;
    color: var(--muted);
  }

  @media (max-width: 768px) {
    .press-header {
      padding: 40px 32px 36px 40px;
    }

    .body {
      padding: 36px 32px 48px 40px;
    }

    .row {
      grid-template-columns: 1fr;
      gap: 10px;
    }

    .date {
      font-size: 24px;
    }
  }
</style>
